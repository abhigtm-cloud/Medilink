rules_version = '2';

// Covers only the collections built so far: RBAC foundation, hospital
// directory sync, Feature 1 (Emergency SOS), Feature 3 (Command Center),
// Feature 6 (Ambulance Management), and notification-flow hardening —
// steps 1-5 of docs/EMERGENCY_PLATFORM_ARCHITECTURE.md §23. Rules for
// pharmacy, analytics, etc. get added in the same change that introduces
// those collections' Cloud Functions/UI.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function myHospitalId() { return request.auth.token.hospitalId; }
    function isHospitalAdmin() { return isSignedIn() && role() == 'hospital_admin'; }
    function isDoctor() { return isSignedIn() && role() == 'doctor'; }
    function isAmbulanceDriver() { return isSignedIn() && role() == 'ambulance_driver'; }
    function isPharmacy() { return isSignedIn() && role() == 'pharmacy'; }
    function isEmergencyStaff() { return isSignedIn() && role() == 'emergency_staff'; }
    function isHospitalStaff() {
      return isHospitalAdmin() || isDoctor() || isAmbulanceDriver() || isPharmacy() || isEmergencyStaff();
    }
    function belongsToHospital(hospitalId) {
      return isHospitalStaff() && myHospitalId() == hospitalId;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---------- RBAC source ----------
    match /user_roles/{uid} {
      allow read: if isOwner(uid) || isHospitalAdmin();
      // only a hospital_admin may write staff roles for THEIR hospital; a user can never self-assign a staff role
      allow create, update: if isHospitalAdmin() && request.resource.data.hospitalId == myHospitalId()
                              && request.resource.data.role in ['doctor','ambulance_driver','pharmacy','emergency_staff'];
      allow delete: if false; // off-boarding sets isActive: false instead
    }

    // ---------- hospital directory / status ----------
    match /hospital_directory/{hospitalId} {
      allow read: if isSignedIn();
      allow write: if false; // mirrorHospitalToFirestore Cloud Function only (Admin SDK)
    }
    match /hospital_status/{hospitalId} {
      allow read: if isSignedIn();
      allow update: if belongsToHospital(hospitalId);
      allow create, delete: if false; // Cloud Function only

      // Lightweight pointer docs the Command Center's "Incoming Requests"
      // list listens to, so it doesn't need a compound query across all of
      // emergency_requests. Written only by triggerEmergencySOS/cancelEmergency.
      match /queue/{requestId} {
        allow read: if belongsToHospital(hospitalId);
        allow write: if false;
      }
    }

    // ---------- emergency requests (Feature 1 — Emergency SOS) ----------
    match /emergency_requests/{requestId} {
      allow read: if isSignedIn() && (
                     resource.data.patientUid == request.auth.uid ||
                     belongsToHospital(resource.data.selectedHospitalId)
                   );
      allow create: if false; // triggerEmergencySOS Callable Function only
      // status transitions (including cancellation) are Cloud-Function-only;
      // the patient may update ONLY their own live location fields directly
      allow update: if isOwner(resource.data.patientUid)
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['patientLocation', 'patientLocationUpdatedAt']);
      allow update: if belongsToHospital(resource.data.selectedHospitalId)
                     && request.resource.data.patientUid == resource.data.patientUid;
      allow delete: if false;

      match /timeline/{eventId} {
        allow read: if isSignedIn() && (
                       get(/databases/$(database)/documents/emergency_requests/$(requestId)).data.patientUid == request.auth.uid ||
                       belongsToHospital(get(/databases/$(database)/documents/emergency_requests/$(requestId)).data.selectedHospitalId)
                     );
        allow write: if false; // Cloud Function only — append-only audit trail
      }
    }

    // ---------- ambulances (Feature 6 — Ambulance Management) ----------
    match /ambulances/{ambulanceId} {
      allow read: if isSignedIn();
      // registerAmbulance/dispatchAmbulance/completeTrip (Cloud Functions)
      // are the intended path; this is a broader safety-net matching
      // architecture doc §6 — ambulances are lower-stakes than emergency
      // medical records, so direct staff edits (fixing a phone number etc.)
      // are allowed too.
      allow write: if belongsToHospital(resource.data.hospitalId)
                     || belongsToHospital(request.resource.data.hospitalId);
      // narrow carve-out: a driver may self-report only their own live
      // location + status, without needing hospital-staff claims
      allow update: if isAmbulanceDriver() && resource.data.driverUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['currentLocation', 'currentLocationUpdatedAt', 'status']);

      match /trips/{tripId} {
        allow read: if isSignedIn();
        allow write: if belongsToHospital(get(/databases/$(database)/documents/ambulances/$(ambulanceId)).data.hospitalId)
                       || (isAmbulanceDriver()
                           && get(/databases/$(database)/documents/ambulances/$(ambulanceId)).data.driverUid == request.auth.uid);
      }
    }
    // mirror of ambulances/{id}/trips/{tripId}, queried by emergencyRequestId
    // for the patient's tracking screen — kept read-only for clients since
    // it's a Cloud-Function-maintained mirror, not a second source of truth.
    match /ambulance_trips/{tripId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- in-app notification center (notification-flow hardening) ----------
    // Reliable fallback for push — see sendFcm.ts / architecture doc §16.
    // Written only by notifyUser/notifyHospitalStaff (Admin SDK); clients
    // may read their own items and mark them read.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // ---------- analytics (Feature 10 — read-only, that hospital's admin only) ----------
    match /analytics_daily/{docId} {
      allow read: if isHospitalAdmin() && docId.matches(myHospitalId() + '_.*');
      allow write: if false; // aggregateDailyAnalytics scheduled Cloud Function only
    }

    // ---------- pharmacy (Feature 7) ----------
    match /medicine_inventory/{hospitalId}/items/{medicineId} {
      allow read: if isSignedIn(); // patients browse to search medicines
      allow write: if belongsToHospital(hospitalId) && (isPharmacy() || isHospitalAdmin());
    }
    match /prescriptions/{prescriptionId} {
      allow read: if isSignedIn() && (
                     resource.data.patientUid == request.auth.uid ||
                     belongsToHospital(resource.data.hospitalId)
                   );
      allow create: if isOwner(request.resource.data.patientUid);
      allow update: if belongsToHospital(resource.data.hospitalId) && (isPharmacy() || isHospitalAdmin());
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
                     resource.data.patientUid == request.auth.uid ||
                     belongsToHospital(resource.data.hospitalId)
                   );
      allow create: if isOwner(request.resource.data.patientUid);
      allow update: if belongsToHospital(resource.data.hospitalId) && (isPharmacy() || isHospitalAdmin());
      allow delete: if false;

      match /tracking/{eventId} {
        allow read: if isSignedIn();
        allow write: if false; // onOrderStatusChange Cloud Function only
      }
    }

    // ---------- AI assistant (Feature 5) ----------
    match /ai_chats/{chatId} {
      allow read, create: if isOwner(resource.data.patientUid) || isOwner(request.resource.data.patientUid);
      allow update: if isOwner(resource.data.patientUid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['lastMessagePreview', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/ai_chats/$(chatId)).data.patientUid);
        // the assistant's reply is sendAiMessage Cloud-Function-only
        allow create: if isOwner(get(/databases/$(database)/documents/ai_chats/$(chatId)).data.patientUid)
                        && request.resource.data.role == 'user';
        allow update, delete: if false;
      }
    }

    // ---------- medication reminders (local notifications, not AI) ----------
    match /medication_reminders/{uid}/items/{reminderId} {
      allow read, write: if isOwner(uid);
    }
  }
}
